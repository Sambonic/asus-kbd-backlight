#!/usr/bin/env python3
import evdev
import os
import select
import time

STATE_FILE = '/var/lib/asus-kbd/state'
KBD_LED_PATH = '/sys/class/leds/asus::kbd_backlight'
DEVICE_NAME = 'Asus WMI hotkeys'
MODES = [0, 1, 2]
KEY_PROG4_CODE = 203

def find_device():
    while True:
        for path in evdev.list_devices():
            try:
                d = evdev.InputDevice(path)
                if DEVICE_NAME in d.name:
                    return d
            except:
                continue
        time.sleep(2)

def read_state():
    try:
        with open(STATE_FILE) as f:
            parts = f.read().strip().split()
            return int(parts[0]), int(parts[1])
    except:
        return 3, 0

def get_brightness():
    try:
        with open(f'{KBD_LED_PATH}/brightness') as f:
            return int(f.read().strip())
    except:
        return 3

def cycle_mode():
    _, current_mode = read_state()
    brightness = get_brightness()
    idx = MODES.index(current_mode) if current_mode in MODES else 0
    next_mode = MODES[(idx + 1) % len(MODES)]
    with open(f'{KBD_LED_PATH}/kbd_rgb_mode', 'w') as f:
        f.write(f'0 {next_mode} 255 255 255 0\n')
    with open(f'{KBD_LED_PATH}/brightness', 'w') as f:
        f.write(f'{brightness}\n')
    with open(STATE_FILE, 'w') as f:
        f.write(f"{brightness} {next_mode}\n")

def main():
    kbd = find_device()
    print(f"Monitoring {kbd.name} at {kbd.path}")

    while True:
        r, _, _ = select.select([kbd.fd], [], [], 1.0)
        if r:
            for event in kbd.read():
                if event.type == 1 and event.code == KEY_PROG4_CODE and event.value == 1:
                    cycle_mode()

if __name__ == '__main__':
    main()
