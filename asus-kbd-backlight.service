[Unit]
Description=ASUS Keyboard Backlight Initialization
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '/tmp/hidapitester/hidapitester --vidpid 0B05/19B6 --open --send-feature 70,1 --close 2>/dev/null; mkdir -p /var/lib/asus-kbd; [ -f /var/lib/asus-kbd/state ] || echo "3 0" > /var/lib/asus-kbd/state; b=$(cut -d" " -f1 /var/lib/asus-kbd/state); m=$(cut -d" " -f2 /var/lib/asus-kbd/state); printf "0 $m 255 255 255 0\n" > /sys/class/leds/asus::kbd_backlight/kbd_rgb_mode; echo $b > /sys/class/leds/asus::kbd_backlight/brightness'

[Install]
WantedBy=multi-user.target
