[Unit]
Description=ASUS Keyboard Backlight Initialization
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '/tmp/hidapitester/hidapitester --vidpid 0B05/19B6 --open --send-feature 70,1 --close 2>/dev/null; echo 3 > /sys/class/leds/asus::kbd_backlight/brightness; printf "0 0 255 255 255 0\n" > /sys/class/leds/asus::kbd_backlight/kbd_rgb_mode; echo 3 > /sys/class/leds/asus::kbd_backlight/brightness'

[Install]
WantedBy=multi-user.target
